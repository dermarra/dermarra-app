FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

DATABASE_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Dermarra Skincare
# Numeric Brevo contact list ID the footer's newsletter form subscribes
# into (Brevo -> Contacts -> Lists). Leave blank to disable newsletter
# signup (returns 503 rather than failing silently).
BREVO_NEWSLETTER_LIST_ID=

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Canonical frontend origin used to build links inside emails (password
# reset, etc). In production this must be the real deployed frontend URL,
# e.g. https://your-site.netlify.app -- distinct from FRONTEND_ORIGIN
# below, which is the full CORS allowlist.
FRONTEND_BASE_URL=http://localhost:5173

FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
